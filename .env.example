# Konfigurasi Workshop PHP + Database (Day 1) & Laravel (Day 2)
# Salin file ini menjadi .env jika ingin mengubah nilai default:
#   cp .env.example .env

# Port web utama yang dibuka peserta di browser
WEB_PORT=8000

# Port phpMyAdmin (opsional)
PHPMYADMIN_PORT=8080

# Password root MariaDB (hanya untuk jaringan lokal workshop)
MYSQL_ROOT_PASSWORD=workshop_root_2026

# Password panel instruktur (/admin)
ADMIN_PASSWORD=instruktur2026

# Jumlah peserta default saat provision
DEFAULT_PARTICIPANTS=60

# IP LAN host (opsional; isi jika deteksi otomatis tidak sesuai, mis. 192.168.1.10)
HOST_LAN_IP=
