# Salin ke .env.prod lalu sesuaikan sebelum deploy:
#   cp .env.prod.example .env.prod

# Domain publik yang diarahkan dari Cloudflare Tunnel -> http://traefik:80
APP_DOMAIN=si.dennis.my.id

# Password kuat untuk produksi (WAJIB diganti!)
MYSQL_ROOT_PASSWORD=ganti_password_root_db_yang_kuat
ADMIN_PASSWORD=ganti_password_admin_yang_kuat

# Opsional:
# - "disabled" (default, direkomendasikan): tombol phpMyAdmin disembunyikan; admin tetap bisa akses DB via infra-pma Tailscale
# - atau isi URL penuh jika phpMyAdmin dibuka ke publik (misal: https://pma-workshop.domainkamu.com/)
PMA_PUBLIC_URL=disabled
